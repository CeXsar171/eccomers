rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['tu-correo-admin@ejemplo.com'];
    }

    // Catálogo público: cualquiera lee, solo el admin escribe.
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
